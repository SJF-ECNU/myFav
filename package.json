{
  "name": "myfav",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "login": "node --env-file-if-exists=.env src/cli.js login",
    "status": "node --env-file-if-exists=.env src/cli.js status",
    "sync": "node --env-file-if-exists=.env src/cli.js sync",
    "test": "node --test",
    "start": "node --env-file-if-exists=.env src/server.js",
    "douyin:login": "node --env-file-if-exists=.env src/douyin-login.js login",
    "douyin:status": "node --env-file-if-exists=.env src/douyin-login.js status",
    "xiaohongshu:login": "node --env-file-if-exists=.env src/xiaohongshu-login.js login",
    "xiaohongshu:status": "node --env-file-if-exists=.env src/xiaohongshu-login.js status"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "cloakbrowser": "^0.6.0",
    "express": "^5.2.1",
    "playwright-core": "^1.64.0",
    "zod": "^4.6.5"
  },
  "description": "Personal favorites MCP for Bilibili, Douyin and Xiaohongshu, with persistent browser sessions and local transcription.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SJF-ECNU/myFav.git"
  }
}
