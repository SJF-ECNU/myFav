# 用本地安全生成的随机值替换；实际 .env 被 Git 忽略
MYFAV_TOKEN=change-me
MYFAV_HOST=127.0.0.1
MYFAV_PORT=8787
MYFAV_FOLDER=myFav
MYFAV_ALLOWED_HOSTS=127.0.0.1:8787,localhost:8787
MYFAV_ALLOWED_ORIGINS=
MYFAV_WHISPER_MODEL=base

# 抖音指定收藏夹
MYFAV_DOUYIN_FOLDER=myFav

# 小红书指定专辑
MYFAV_XIAOHONGSHU_FOLDER=myFav

# 浏览器后端：cloakbrowser（默认）、chromium、cdp
MYFAV_BROWSER=cloakbrowser
# chromium 模式必填：运行环境中的可执行文件路径
MYFAV_BROWSER_EXECUTABLE_PATH=
# cdp 模式必填：已有浏览器提供的 HTTP(S) 或 WS(S) 端点
MYFAV_CDP_URL=

# 每个 Agent 每分钟的 HTTP 请求上限（包含 MCP 初始化）
MYFAV_RATE_LIMIT_PER_MINUTE=60
# OAuth 2.1：配置外部授权服务与本服务的公开 HTTPS 资源地址
MYFAV_OAUTH_ISSUER=
MYFAV_OAUTH_RESOURCE=
# 可选：不透明令牌使用标准 introspection；留空使用 JWT/JWKS
MYFAV_OAUTH_INTROSPECTION_URL=
MYFAV_OAUTH_CLIENT_ID=
MYFAV_OAUTH_CLIENT_SECRET=
